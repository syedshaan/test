GEMINI_API_KEY=
# Use a stronger model for paid drafts, e.g. gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
# Set to "off" to skip the unsupported-facts check (saves cost/latency)
DRAFT_VERIFY=on
OWNER_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Shared rate limiting across serverless instances (recommended; free tier at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional bot protection (frontend widget not wired yet)
TURNSTILE_SECRET_KEY=
